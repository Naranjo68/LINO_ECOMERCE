{
  "name": "lino-tienda-online",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LINO - Tienda de ropa online. React, Vite, Express y almacenamiento JSON local.",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "concurrently -k -n API,REACT -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node --watch backend/src/server.js",
    "start:api": "node backend/src/server.js",
    "init:data": "node scripts/init-data.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "check:data": "node scripts/validate-data.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "vite": "^6.0.5"
  }
}
