# Puerto local del backend (Render asigna PORT automáticamente).
PORT=3001
NODE_ENV=development

# En desarrollo local puedes dejar DATABASE_URL vacío para usar archivos JSON.
# Para importar datos a Neon, pega aquí la cadena privada de conexión.
DATABASE_URL=

# Clave persistente para firmar las sesiones. Genera una propia antes de producción.
LINO_SESSION_SECRET=

# Opcional: orígenes externos permitidos si se consume la API directamente.
# Con el rewrite same-origin de Vercel normalmente no hace falta configurarlo.
CORS_ORIGINS=http://localhost:5173

# Opcional: rutas locales de los archivos JSON que se importarán a Neon.
# LINO_DATA_FILE=data/tienda.json
# LINO_DB_FILE=data/bd.json
